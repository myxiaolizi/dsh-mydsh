# Node and package managers
node_modules/
.pnpm-store/

# Build and deployment intermediates
APP/tmp/
agent/scratch/
dist/
*.tsbuildinfo

# Local settings and user data.
# These are anchored to the repository root and the two data directories the
# plugin writes at runtime, because an unanchored `images/` also matches the
# source directory `host/modules/images/` and silently drops it from a commit.
/.env
/.env.*
!/.env.example
/settings.json
/notices.jsonl
/data/
/backups/
/restore/
/screenshots/
/generated-images/

# Editor and OS noise
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp
desktop.ini
